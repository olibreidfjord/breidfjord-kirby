{% extends 'default.twig' %}

{% block main %}

  <section class="px-4 pt-[20%] md:px-8">

    {% set heading %}
      {% include '@snippets/title.twig' %}
    {% endset %}

    {% set body %}
      {%~ if page.standfirst.isNotEmpty %}
      <p class="text-2xl font-copy text-[#aeaeae]">{{ page.standfirst }}</p>
      {%~ endif %}
    {% endset %}

    <div class="page-intro">
      {% include '@snippets/section-intro.twig' with { heading, body } %}
    </div>

  </section>

  {%~ if page.text.isNotEmpty %}
  <section class="px-4 pt-16 pb-[10%] md:px-8">

    <div class="copy text-2xl max-w-copy">
      {{ page.text.kirbytext | raw }}
    </div>

  </section>
  {%~ endif %}

{% endblock main %}
