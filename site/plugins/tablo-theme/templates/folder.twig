{% extends 'default.twig' %}

{% block main %}

  <section class="px-4 pt-[20%] pb-[10%] md:px-8">

    {%~ set allBlocks = page.blocks.toBlocks %}
    {%~ set headingBlock = allBlocks.filterBy('type', 'heading').first %}
    {%~ set bodyBlocks = allBlocks.filterBy('type', '!=', 'heading') %}

    {% set heading %}
      {%~ if headingBlock %}
      {% include '@snippets/blocks/heading.twig' with { block: headingBlock } %}
      {%~ endif %}
    {% endset %}

    {% set body %}
      {% include '@snippets/blocks.twig' with { blocks: bodyBlocks } %}
    {% endset %}

    <div class="works-intro">
      {% include '@snippets/section-intro.twig' with { heading, body } %}
    </div>

  </section>

  <section class="px-4 py-16 md:px-8">

    {% include '@snippets/works-grid.twig' %}

  </section>

{% endblock main %}
