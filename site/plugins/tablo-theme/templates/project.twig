{% extends 'default.twig' %}

{% block main %}

  <section class="px-4 pt-[15%] pb-0 md:px-8">

    {% set heading %}
      {% include '@snippets/title.twig' %}
    {% endset %}

    {% set body %}
      {% include '@snippets/blocks.twig' %}
    {% endset %}

    <div class="project-copy">
      {% include '@snippets/section-intro.twig' with { heading, body } %}
    </div>

  </section>

  {%~ if page.media.isNotEmpty %}
  <section class="px-4 py-16 md:px-8">

    {%~ with { media: page.media.toFiles } %}
    <div class="masonry-grid" data-masonry>
      {%~ for image in media %}
      <figure class="masonry-item" data-masonry-item>
        <button
          type="button"
          class="block w-full p-0 border-0 bg-transparent text-left cursor-pointer"
          data-lightbox-trigger
          data-lightbox-src="{{ image.thumb({ width: 2400, format: 'webp' }).url }}"
          aria-label="Open image"
        >
          {%~ include '@snippets/grid-item.twig' with { image } only ~%}
        </button>
        {%~ if image.caption.isNotEmpty %}
        <figcaption class="mt-3 font-copy font-light leading-[1.2] text-sm text-[#aeaeae]">{{ image.caption }}</figcaption>
        {%~ endif %}
      </figure>
      {%~ endfor %}
    </div>
    {%~ endwith %}

  </section>
  {%~ endif %}

  {%~ with {
    prev: page.prevAll.listed.template('project').last ?? page.nextAll.listed.template('project').last,
    next: page.nextAll.listed.template('project').first ?? page.prevAll.listed.template('project').first,
  } %}
  {%~ if next %}
  <aside class="px-4 py-16 md:px-8">

    <div class="mx-auto max-w-3xl flex flex-row justify-center text-center">
      <a class="py-2 -my-2 flex flex-col group" href="{{ next.url }}">
        <span class="text-2xl lowercase text-[#aeaeae]">{{ t('tablo.label.next') }}</span>
        <span class="text-4xl uppercase text-white"><span class="group-hover:underline">{{ next.title }}</span><span class="ml-1">&rarr;</span></span>
      </a>
    </div>
  </aside>
  {%~ endif %}
  {%~ endwith %}

{% endblock main %}
