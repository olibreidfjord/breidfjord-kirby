{% extends 'default.twig' %}

{% block main %}

  <section class="px-4 pt-[max(9rem,15%)] pb-0 md:px-8">

    {% set heading %}
      {% include '@snippets/title.twig' %}
    {% endset %}

    {% set body %}
      {% include '@snippets/blocks.twig' %}
    {% endset %}

    {%~ if page.parent %}
    <a class="mb-7 inline-flex flex-row items-center gap-2.5 min-h-11 font-copy text-sm uppercase tracking-[1.7px] text-accent-text hover:text-white" href="{{ page.parent.url }}">
      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
      All {{ page.parent.title | lower }}
    </a>
    {%~ endif %}

    <div class="project-copy">
      {% include '@snippets/section-intro.twig' with { heading, body } %}
    </div>

  </section>

  {%~ if page.media.isNotEmpty %}
  <section class="px-4 py-16 md:px-8">

    {%~ with { media: page.media.toFiles } %}
    <div class="masonry-grid" data-masonry>
      {%~ for image in media %}
      <figure class="masonry-item" data-masonry-item>
        <button
          type="button"
          class="group block w-full p-0 border-0 bg-transparent text-left cursor-pointer"
          data-lightbox-trigger
          data-lightbox-src="{{ image.thumb({ width: 2400, format: 'webp' }).url }}"
          aria-label="Open image{{ image.worktitle.isNotEmpty ? ': ' ~ image.worktitle : '' }}"
        >
          {%~ include '@snippets/grid-item.twig' with { image, overlay: true, lazy: loop.index > 6 } only ~%}
        </button>
        {% include '@snippets/artwork-caption.twig' with { image } only %}
      </figure>
      {%~ endfor %}
    </div>
    {%~ endwith %}

  </section>
  {%~ endif %}

  {%~ with {
    prev: page.prevAll.listed.template('project').last ?? page.nextAll.listed.template('project').last,
    next: page.nextAll.listed.template('project').first ?? page.prevAll.listed.template('project').first,
  } %}
  {%~ if next %}
  <aside class="px-4 py-16 md:px-8">

    <div class="mx-auto max-w-3xl flex flex-row justify-center text-center">
      <a class="py-2 -my-2 flex flex-col group" href="{{ next.url }}">
        <span class="font-copy text-sm uppercase tracking-[1.7px] text-[#aeaeae]">{{ t('tablo.label.next') }}</span>
        <span class="text-4xl uppercase text-white"><span class="group-hover:underline">{{ next.title }}</span><span class="ml-2 text-accent">&rarr;</span></span>
      </a>
    </div>
  </aside>
  {%~ endif %}
  {%~ endwith %}

{% endblock main %}
