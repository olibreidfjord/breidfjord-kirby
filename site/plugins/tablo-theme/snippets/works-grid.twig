{% with { projects: projects ?? site.find('projects').children().listed } %}
<div class="masonry-grid works-grid" data-masonry>
  {%~ for project in projects %}
  <div class="masonry-item" data-masonry-item>
    {%~ embed '@snippets/grid-item.twig' with {
      project: project,
      image:   project.getCoverImage,
      url:     project.url,
    } only ~%}
      {%- block after -%}
      <h2 class="mt-4 text-2xl uppercase text-white">{{ project.title }}</h2>
      {%~ if project.description.isNotEmpty %}
      <h3 class="text-2xl font-copy text-[#8C938D]">{{ project.description }}</h3>
      {%~ endif %}
      {%- endblock -%}
    {%~ endembed ~%}
  </div>
  {%~ endfor %}
</div>
{% endwith %}
