{% with { projects: projects ?? site.find('projects').children().listed } %}
<div class="masonry-grid works-grid" data-masonry>
  {%~ for project in projects %}
  <div class="masonry-item" data-masonry-item>
    {%~ embed '@snippets/grid-item.twig' with {
      project: project,
      image:   project.getCoverImage,
      url:     project.url,
    } only ~%}
      {%- block after -%}
      {% include '@snippets/category-tile-caption.twig' with { title: project.title, description: project.description } %}
      {%- endblock -%}
    {%~ endembed ~%}
  </div>
  {%~ endfor %}
</div>
{% endwith %}
