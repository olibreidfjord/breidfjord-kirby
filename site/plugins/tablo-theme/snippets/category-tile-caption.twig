{#
  Caption row for a category tile (homepage curated grid + works overview
  grid) — title left, description + circled chevron right, space-between.
  Stacks (title above description) below lg. Shared so both listings match.
  Params: title, description (Kirby Field)
#}
<div class="mt-8 flex flex-col gap-1 lg:flex-row lg:items-baseline lg:justify-between lg:gap-4">
  <h2 class="text-2xl uppercase text-white">{{ title }}</h2>
  {%~ if description.isNotEmpty %}
  <h3 class="text-2xl font-copy text-[#aeaeae]">{{ description }}</h3>
  {%~ endif %}
</div>
